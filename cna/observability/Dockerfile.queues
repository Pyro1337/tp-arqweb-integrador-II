FROM python:3.12-slim
WORKDIR /app
COPY requirements-exporter.txt ./
RUN pip install --no-cache-dir -r requirements-exporter.txt
COPY queue_exporter.py ./
USER 1001:1001
HEALTHCHECK --interval=15s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2)"
CMD ["uvicorn", "queue_exporter:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
